POSTGRES_DB=socintel_v2
POSTGRES_USER=socintel
POSTGRES_PASSWORD=replace-with-strong-random-password
REDIS_PASSWORD=replace-with-strong-random-password
DATABASE_URL=postgresql+psycopg://socintel:replace-with-strong-random-password@postgres:5432/socintel_v2
REDIS_URL=redis://:replace-with-strong-random-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-strong-random-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-strong-random-password@redis:6379/0
LEGACY_BACKEND_PATH=/srv/socintel-legacy-backend
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_COOKIE_NAME=socintel_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
ENVIRONMENT=production
EXPOSE_API_DOCS=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CORS_ORIGINS=https://socintel.example.com
