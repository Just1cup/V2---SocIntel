POSTGRES_DB=socintel_v2
POSTGRES_USER=socintel
POSTGRES_PASSWORD=replace-with-strong-random-password
REDIS_PASSWORD=replace-with-strong-random-password
DATABASE_URL=postgresql+psycopg://socintel:replace-with-strong-random-password@localhost:5432/socintel_v2
REDIS_URL=redis://:replace-with-strong-random-password@localhost:6379/0
CELERY_BROKER_URL=redis://:replace-with-strong-random-password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-strong-random-password@localhost:6379/0
LEGACY_BACKEND_PATH=/path/to/socintel-legacy-backend
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=socintel_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ENVIRONMENT=development
EXPOSE_API_DOCS=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
TAXII_REQUEST_TIMEOUT_SECONDS=20
TAXII_CACHE_TTL_SECONDS=600
TAXII_MITRE_BASE_URL=https://attack-taxii.mitre.org
TAXII_MITRE_API_ROOT=/api/v21
SOCINTEL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-random-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8000
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
